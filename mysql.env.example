# ===========================================================================
# MySQL 容器密钥/初始化配置模板
# 复制为 ~/dsh-superagent-data/mysql.env 并替换真实值（推荐用 openssl rand 生成）
# 或直接运行 scripts/init-data.sh 自动生成随机密码的 mysql.env
# 首次启动时 MySQL 会用这些变量初始化数据目录；之后改动需重建数据目录。
# ===========================================================================

# root 密码（务必换成强密码）
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_PASSWORD

# 给 super-agent 用的应用数据库
MYSQL_DATABASE=super_agent_test

# 给 agent worker 连接用的专用低权限账号（DBeaver 也可以用这个）
MYSQL_USER=sa_worker
MYSQL_PASSWORD=CHANGE_ME_worker_PASSWORD