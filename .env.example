# 可选：复制为 .env 后按需覆盖（docker compose 与 scripts/setup.* 都会读取）
# DSA_DATA_DIR=/absolute/path/dsh-superagent-data   # 数据目录：首次部署前定好，之后别改（见 README「本地数据目录」）
# SUPERAGENT_REPO=https://github.com/<you>/<fork>.git
# SUPERAGENT_REF=main
# SUPERAGENT_INSTALL_GO=0   # 设为 1 启用 Go（默认不装）
# SUPERAGENT_INSTALL_FLUTTER=0   # 设为 1 启用 Flutter（默认不装）
